<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.base</groupId>
    <artifactId>fullstack-base-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>base-main</artifactId>
  <name>base-main</name>
  <description>可执行模块：启动类 + 全部配置 + Flyway 迁移 + 打包。只在这里聚合业务模块</description>

  <dependencies>
    <!-- ============================================================
         业务模块登记处（扩展入口 ③）
         scripts/new-module.js 会在 @NEW_DEPENDENCY 锚点前自动插入依赖。
         漏登记 = 模块代码编译了但没进 jar，接口 404 且无任何报错。
         ============================================================ -->
    <dependency>
      <groupId>com.example.base</groupId>
      <artifactId>base-module-user</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example.base</groupId>
      <artifactId>base-module-product</artifactId>
    </dependency>
    <!-- @NEW_DEPENDENCY -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Flyway：启动时按版本号执行 db/migration 下的 SQL，自动建表 + 灌演示数据 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Flyway 10+ 把 MySQL 支持拆成独立模块，不引会在 mysql profile 下报错 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <!-- 默认 H2 内存库；MODE=MySQL 让 SQL 写法与真实 MySQL 保持一致 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 打成可执行 jar：java -jar main/target/base-main-0.1.0-SNAPSHOT.jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- 命令行参数优先级高于环境变量：某些 IDE / CI 会注入 SERVER__PORT，
               Spring Boot 松散绑定会把它当成 server.port 顶掉 application.yml。
               这里显式钉死，保证 mvn spring-boot:run 永远落在 8082 -->
          <arguments>
            <argument>--server.port=8082</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

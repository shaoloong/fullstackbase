<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 继承 Boot 官方 parent：统一管理依赖版本；java.version=21 会传给编译器的 release 参数 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.example.base</groupId>
  <artifactId>fullstack-base-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>fullstack-base-backend</name>
  <description>后端 Maven 多模块：common → core → modules/* → main（严格单向依赖）</description>

  <!-- ============================================================
       模块登记处（扩展入口 ①）
       scripts/new-module.js 会在 @NEW_MODULE 锚点前自动插入新模块行。
       手工新增模块时也要在这里加一行，否则 Maven 根本不会编译它。
       ============================================================ -->
  <modules>
    <module>common</module>
    <module>core</module>
    <module>modules/user</module>
    <module>modules/product</module>
    <!-- @NEW_MODULE -->
    <module>main</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <mybatis-plus.version>3.5.9</mybatis-plus.version>
    <!-- springdoc 2.8.x 才完整支持 Boot 3.5 / Spring Framework 6.2；3.x 是 Boot 4 专用 -->
    <springdoc.version>2.8.13</springdoc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 本仓库模块：新增业务模块时在此登记（扩展入口 ②，生成器自动插入） -->
      <dependency>
        <groupId>com.example.base</groupId>
        <artifactId>base-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.base</groupId>
        <artifactId>base-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.base</groupId>
        <artifactId>base-module-user</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.base</groupId>
        <artifactId>base-module-product</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- @NEW_DEPENDENCY -->

      <!-- 契约：OpenAPI 3 文档 + Swagger UI -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <!-- ⚠️ MP 3.5.9 起分页插件被拆到独立模块，starter 不再传递依赖它。
           缺了它 PaginationInnerInterceptor 会「找不到符号」直接编译失败 -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-jsqlparser</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- 全模块共享依赖：放根 dependencies 是各模块零重复的唯一做法。
       ⚠️ Lombok 必须放这里：common 里声明为 optional 的依赖不会传递给 core / modules，
       而 @Slf4j / @Data / @RequiredArgsConstructor 在这些模块里都要用 -->
  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

# 环境变量示例：复制为 .env 使用（.env* 已 gitignore）
# 缺省值见 apps/backend/main/src/main/resources/application*.yml

# ----- 后端端口 -----
# 注意：某些 IDE / CI 会注入 SERVER__PORT，Spring Boot 松散绑定会把它当成
# server.port 并顶掉 application.yml。本工程在 main/pom.xml 里用命令行参数
# 钉死 8082，环境变量不再生效。
BACKEND_PORT=8082
FRONTEND_PORT=5174

# ----- 切 MySQL profile 时的连接参数 -----
# MYSQL_HOST=localhost
# MYSQL_PORT=13307
# MYSQL_DB=fullstack_base
# MYSQL_USER=root
# MYSQL_PASS=change-me

# ----- 前端 Vite 代理目标（vite.config.js 读 process.env）-----
# VITE_PROXY_TARGET=http://localhost:8082
